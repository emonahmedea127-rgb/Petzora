{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "petzora.shop" }],
      "destination": "https://www.petzora.shop/$1",
      "permanent": true
    },
    {
      "source": "/author/dr-clara-vance",
      "destination": "/author/emon-ahmed",
      "permanent": true
    },
    {
      "source": "/author/marcus-hayes",
      "destination": "/author/emon-ahmed",
      "permanent": true
    },
    {
      "source": "/author/elena-rostova",
      "destination": "/author/emon-ahmed",
      "permanent": true
    },
    {
      "source": "/author/petzora-health-desk",
      "destination": "/author/emon-ahmed",
      "permanent": true
    },
    {
      "source": "/author/petzora-training-desk",
      "destination": "/author/emon-ahmed",
      "permanent": true
    },
    {
      "source": "/author/petzora-care-desk",
      "destination": "/author/emon-ahmed",
      "permanent": true
    },
    {
      "source": "/author/petzora-editorial-team",
      "destination": "/author/emon-ahmed",
      "permanent": true
    },
    {
      "source": "/author/petzora-cat-care-desk",
      "destination": "/author/emon-ahmed",
      "permanent": true
    },
    {
      "source": "/terms-of-service",
      "destination": "/terms",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
